{
  "name": "nutridb-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "NUTRIDB Explorer (SPEC §12) - F1.8b: minimal search page over the packaged SQLite via WASM.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "gen-locales": "node scripts/gen-locales.mjs",
    "predev": "npm run copy-wasm && npm run gen-locales",
    "dev": "vite",
    "prebuild": "npm run copy-wasm && npm run gen-locales",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.49.1-build3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "smol-toml": "^1.8.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
